# Copy this file to .env and fill it in yourself. .env is gitignored. Never commit it.
# Used only by the spike and the feeder; the simulator needs none of this.
WHISKER_USERNAME=
WHISKER_PASSWORD=

# Where frames are pushed. The simulator by default; set to http://<clock-ip> for the real clock.
CLOCK_URL=http://localhost:7001

# PETLIBRO (scripts/spike_petlibro.py). Use a SECOND PETLIBRO account, not your own: logging in
# here logs that account out of the phone app. Create it in the PETLIBRO phone app (not on the
# website), share the Granary and fountain with it from your own account, and accept the share.
PETLIBRO_EMAIL=
PETLIBRO_PASSWORD=
# Optional IANA timezone, for example America/Chicago. Detected from the system when empty.
PETLIBRO_TIMEZONE=
